# Configuration MongoDB - OBLIGATOIRE
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Exemple pour MongoDB local (optionnel)
# MONGODB_URI=mongodb://localhost:27017/

# Configuration du scraping (optionnel)
SCRAPING_INTERVAL=300  # Intervalle en secondes entre les scrapes automatiques
MAX_RETRIES=3          # Nombre de tentatives en cas d'échec
HEADLESS_MODE=true     # true pour mode headless, false pour voir le navigateur

# Configuration du dashboard (optionnel)
DASHBOARD_PORT=8501    # Port pour Streamlit
DASHBOARD_HOST=0.0.0.0 # Adresse d'écoute

# Logging (optionnel)
LOG_LEVEL=INFO         # DEBUG, INFO, WARNING, ERROR
